# Виртуальное окружение — своя копия Python и библиотек
venv/
.venv/
env/

# Байткод Python и кэш интерпретатора
__pycache__/
*.py[cod]
*$py.class

# Результаты работы программы (генерируются при запуске)
report.json
report.txt
*.log

# Настройки IDE / редакторов
.idea/
.vscode/

# Файлы ОС
.DS_Store
Thumbs.db

# Временные файлы
*.tmp
*.bak